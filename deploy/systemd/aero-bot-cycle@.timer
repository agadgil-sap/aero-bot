[Unit]
Description=Run the Aero Bot authoritative decision cycle every five minutes
Documentation=file:/opt/aero-bot/docs/cycle.md

[Timer]
# The policy contains fifteen-minute persistence rules. A five-minute cycle
# cadence observes those rules with bounded latency while keeping one single
# reconcile-decide-act authority.
OnCalendar=*:0/5
Persistent=true
AccuracySec=15s
# Small jitter avoids synchronized public-RPC load without materially
# changing the policy's timing.
RandomizedDelaySec=15
# systemd will never overlap a still-running instance of this oneshot.
Unit=aero-bot-cycle@%i.service

[Install]
WantedBy=timers.target
